# MirageOS 本地服务配置 —— 复制为 .env 并填写（.env 已被 .gitignore 排除，严禁提交）
# 任何兼容 Anthropic /v1/messages 协议的端点均可（官方 API 或中转站）
API_BASE_URL=https://api.anthropic.com
API_KEY=sk-ant-your-key-here

# 模型名（按端点实际提供的模型填写）
MODEL=claude-opus-5-5

# 可选：思考等级（不支持的模型/端点请留空）
# MODEL_REASONING_EFFORT=low

# 可选：开机门禁密码。设置后打开页面先出锁屏，所有 /api/* 需带该口令；本机自用可不设
# GATE_PASSWORD=

# 可选：调试 —— 把每次生成的原始 SSE 输出记录到 tmp/mirage-debug.log
# MIRAGE_DEBUG=1
